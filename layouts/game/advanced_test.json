  "text_replacement": {
    "rules": [
      {
        "find": "\\bx(\\d+)\\b",
        "replace": "times \\1",
        "regex": true,
        "sample": "Healing Potion x3"
      },
      {
        "find": "(\\d+)\\s*/\\s*(\\d+)",
        "replace": "\\1 of \\2",
        "regex": true,
        "sample": "Health 45/100"
      },
      {
        "find": "\\s*\\[[^\\]]*\\]",
        "replace": "",
        "regex": true,
        "sample": "Welcome back [ID 2231] traveler"
      },
      {
        "find": "\\s*DC:\\s*\\d+\\s*(Failure|Success)",
        "replace": "",
        "regex": true,
        "sample": "You open the door. DC: 45 Failure"
      },
      {
        "find": "(\\d+)\\s*(?:gp|GP)\\b",
        "replace": "\\1 gold",
        "regex": true,
        "sample": "Sword 250 gp"
      },
      {
        "find": "\\bLv\\.?\\s*(\\d+)",
        "replace": "level \\1",
        "regex": true,
        "sample": "Lv. 12 Goblin"
      },
      {
        "find": "\\b(\\d{1,2}):(\\d{2})\\s*(AM|PM)\\b",
        "replace": "\\1 \\2 \\3",
        "regex": true,
        "sample": "Shop opens at 9:30 AM"
      },
      {
        "find": "(?i)\\b(hp|mp|xp)\\s*\\+\\s*(\\d+)",
        "replace": "plus \\2 \\1",
        "regex": true,
        "sample": "HP +20"
      },
      {
        "find": "ATK",
        "replace": "attack"
      },
      {
        "find": "DEF",
        "replace": "defense"
      },
      {
        "find": "STR",
        "replace": "strength"
      },
      {
        "find": "lvl",
        "replace": "level"
      },
      {
        "find": "HP",
        "change": "number",
        "say_amount": true
      },
      {
        "find": "Gold",
        "change": "number",
        "say_amount": true
      },
      {
        "find": "Quest:",
        "change": "text",
        "changed_text": "Changed:"
      }
    ],
    "enabled": true
  },
  "text_filters": {
    "char_normalization": true,
    "ignore_already_read": true,
    "ignore_usernames": true,
    "ignore_gibberish": true,
    "unit_detection": true,
    "ignored_words": "Press, Skip, Auto, Save, Load, Options, Quit"
  },
